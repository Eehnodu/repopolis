{
  "name": "repopolis",
  "version": "1.0.0",
  "description": "코드가 사는 도시 — 프로젝트 폴더를 살아 움직이는 3D 도시로",
  "author": "Eehnodu",
  "license": "MIT",
  "private": true,
  "main": "app/main.js",
  "repository": "github:Eehnodu/repopolis",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "node app/start.js",
    "scan": "node scan.js",
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dir --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.9.0",
    "electron": "38.8.6",
    "electron-builder": "24.13.3",
    "three": "0.160.0"
  },
  "build": {
    "appId": "com.eehnodu.repopolis",
    "productName": "Repopolis",
    "asar": false,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["app/**", "scan.js", "viewer.html", "package.json"],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }], "icon": "build/icon.png" },
    "portable": { "artifactName": "Repopolis-windows.exe" },
    "mac": { "target": ["dir"], "icon": "build/icon.png", "identity": null, "category": "public.app-category.developer-tools" }
  }
}
